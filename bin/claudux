#!/bin/bash
#
# claudux - Docs that stay true to your code
# Generates and serves VitePress docs via Claude or Codex
#

# Script setup - check for undefined variables; avoid -e to allow graceful handling
set -u
set -o pipefail  # Pipe failure propagates

CLAUDUX_LOCK_PATH=""

release_project_lock() {
    local lock_path="${CLAUDUX_LOCK_PATH:-}"
    local lock_pid=""

    if [[ -z "$lock_path" ]] || [[ ! -d "$lock_path" ]] || [[ -L "$lock_path" ]]; then
        return 0
    fi

    lock_pid=$(cat "$lock_path/pid" 2>/dev/null || true)
    if [[ "$lock_pid" == "$$" ]]; then
        rm -f -- "$lock_path/pid"
        rmdir -- "$lock_path" 2>/dev/null || true
    fi

    CLAUDUX_LOCK_PATH=""
}

# Better interrupt handling
cleanup_on_exit() {
    local exit_code=$?
    local job_pid
    local job_pids=()

    # Kill any background processes
    while IFS= read -r job_pid; do
        if [[ -n "$job_pid" ]]; then
            job_pids[${#job_pids[@]}]="$job_pid"
        fi
    done < <(jobs -p 2>/dev/null)

    if [[ ${#job_pids[@]} -gt 0 ]]; then
        for job_pid in "${job_pids[@]}"; do
            kill "$job_pid" 2>/dev/null || true
        done
        for job_pid in "${job_pids[@]}"; do
            wait "$job_pid" 2>/dev/null || true
        done
    fi

    if declare -F cleanup_docs_generation_runtime >/dev/null 2>&1; then
        cleanup_docs_generation_runtime
    fi
    release_project_lock

    exit $exit_code
}

trap cleanup_on_exit EXIT

# Get the directory where this script is located with robust symlink resolution
resolve_script_path() {
    local source="${BASH_SOURCE[0]}"
    local count=0
    
    while [[ -L "$source" ]] && [[ $count -lt 10 ]]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" 2>/dev/null && pwd)"
        if [[ -z "$dir" ]]; then
            echo "ERROR: Could not resolve directory for: $source" >&2
            return 1
        fi
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
        ((count++))
    done
    
    if [[ $count -eq 10 ]]; then
        echo "ERROR: Too many symlink levels (possible loop)" >&2
        return 1
    fi
    
    cd -P "$(dirname "$source")" 2>/dev/null && pwd
}

SCRIPT_DIR="$(resolve_script_path)"
if [[ -z "$SCRIPT_DIR" ]]; then
    echo "ERROR: Could not determine script directory" >&2
    exit 1
fi

# Store the directory where the user called the script from
# This ensures docs are always generated in the user's project root
WORKING_DIR="$(pwd)"
if [[ ! -d "$WORKING_DIR" ]]; then
    echo "ERROR: Working directory does not exist: $WORKING_DIR" >&2
    exit 1
fi

# Export for use in sourced scripts
export SCRIPT_DIR
export WORKING_DIR

# Always work from the directory where the user called the script
cd "$WORKING_DIR" || exit 1

# Informational commands answer from anywhere; everything else needs a repo.
case "${1:-}" in
    "--version"|"version"|-V|"--help"|"-h"|"help"|"check"|"--check")
        CLAUDUX_SKIP_GIT_GATE=true
        ;;
    *)
        CLAUDUX_SKIP_GIT_GATE=false
        ;;
esac

# Commands that change files need a git repository. Informational commands
# answer from anywhere, but inside a repository every command answers for
# the project root, so `claudux check` run from docs/ reports the root's
# docs/ state and project type rather than the subdirectory's.
if git rev-parse --git-dir > /dev/null 2>&1; then
    PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -n "$PROJECT_ROOT" && "$PWD" != "$PROJECT_ROOT" ]]; then
        echo "📍 Changing to project root: $PROJECT_ROOT" >&2
        cd "$PROJECT_ROOT" || exit 1
    fi
elif [[ "$CLAUDUX_SKIP_GIT_GATE" != "true" ]]; then
    echo "⚠️  No git repository found. Are you in the right directory?"
    echo "   Run claudux from your project root (where .git lives)"
    exit 1
fi

# Determine lib directory location
LIB_DIR="$SCRIPT_DIR/../lib"
if [[ ! -d "$LIB_DIR" ]]; then
    echo "ERROR: Library directory not found: $LIB_DIR" >&2
    echo "Expected at: $LIB_DIR" >&2
    exit 1
fi

# Source all library modules with error handling
REQUIRED_LIBS=("colors.sh" "project.sh" "content-protection.sh" "claude-utils.sh" "git-utils.sh" "docs-manifest.sh" "docs-generation.sh" "cleanup.sh" "server.sh" "ui.sh")

for lib in "${REQUIRED_LIBS[@]}"; do
    lib_path="$LIB_DIR/$lib"
    if [[ ! -f "$lib_path" ]]; then
        echo "ERROR: Required library file not found: $lib_path" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    if ! source "$lib_path"; then
        echo "ERROR: Failed to source library: $lib_path" >&2
        exit 1
    fi
done

# Source Codex backend adapter when CLAUDUX_BACKEND=codex
# Soft-load: warn but don't exit — allows diagnostic commands (check, help)
# to run even when codex-utils.sh is not yet installed.
if [[ "${CLAUDUX_BACKEND:-}" == "codex" ]]; then
    codex_lib="$LIB_DIR/codex-utils.sh"
    if [[ -f "$codex_lib" ]]; then
        # shellcheck source=/dev/null
        source "$codex_lib"
    else
        CODEX_UTILS_MISSING=true
    fi
fi

# Helper function to check if a function exists
check_function() {
    local func_name="$1"
    if ! declare -F "$func_name" >/dev/null 2>&1; then
        echo "ERROR: Required function '$func_name' not found. Library loading may have failed." >&2
        exit 1
    fi
}

validate_backend_selection() {
    local backend="${CLAUDUX_BACKEND:-claude}"

    case "$backend" in
        claude|codex)
            return 0
            ;;
        *)
            error_exit "Unsupported CLAUDUX_BACKEND '$backend'; expected 'claude' or 'codex'" 2
            ;;
    esac
}

# Validate a PID read from a lock before passing it to kill.
is_lock_pid() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

report_live_lock() {
    local lock_pid="$1"
    warn "Another claudux instance is already running (PID: $lock_pid)"
    warn "Refusing to run concurrent project updates"
}

# Older releases used a plain lock file. Honor live owners and remove only a
# regular, unchanged file whose recorded process is no longer running.
recover_legacy_lock() {
    local lock_file="$1"
    local lock_pid current_pid

    if [[ ! -e "$lock_file" ]] && [[ ! -L "$lock_file" ]]; then
        return 0
    fi
    if [[ -L "$lock_file" ]] || [[ ! -f "$lock_file" ]]; then
        warn "Project lock has an unsafe legacy format: $lock_file"
        return 1
    fi

    lock_pid=$(cat "$lock_file" 2>/dev/null || true)
    if ! is_lock_pid "$lock_pid"; then
        warn "Project lock has an invalid owner and cannot be recovered safely: $lock_file"
        return 1
    fi
    if kill -0 "$lock_pid" 2>/dev/null; then
        report_live_lock "$lock_pid"
        return 1
    fi

    current_pid=$(cat "$lock_file" 2>/dev/null || true)
    if [[ "$current_pid" != "$lock_pid" ]] || kill -0 "$current_pid" 2>/dev/null; then
        warn "Project lock changed during stale-lock recovery"
        return 1
    fi

    rm -f -- "$lock_file"
}

# Claim stale-lock recovery inside the existing directory. The directory keeps
# new owners out until the reclaimer has revalidated and removed the dead lock.
reclaim_stale_lock() {
    local lock_path="$1"
    local expected_pid="$2"
    local reclaim_path="$lock_path/.reclaim"
    local current_pid

    if ! mkdir "$reclaim_path" 2>/dev/null; then
        return 2
    fi
    if ! printf '%s\n' "$$" > "$reclaim_path/pid"; then
        rmdir "$reclaim_path" 2>/dev/null || true
        return 1
    fi

    current_pid=$(cat "$lock_path/pid" 2>/dev/null || true)
    if [[ "$current_pid" != "$expected_pid" ]] ||
        ! is_lock_pid "$current_pid" ||
        kill -0 "$current_pid" 2>/dev/null; then
        rm -f -- "$reclaim_path/pid"
        rmdir "$reclaim_path" 2>/dev/null || true
        return 1
    fi

    rm -rf -- "$lock_path"
}

# Implement atomic project locking for concurrent execution safety.
acquire_lock() {
    local lock_dir lock_path legacy_lock_file lock_pid path_hash
    local attempts=0
    local reclaim_result

    lock_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claudux/locks"
    if ! mkdir -p "$lock_dir"; then
        warn "Could not create project lock directory: $lock_dir"
        return 1
    fi

    path_hash="$(pwd | md5sum 2>/dev/null | cut -d' ' -f1 || pwd | md5 | awk '{print $NF}')"
    if [[ -z "$path_hash" ]]; then
        warn "Could not derive a project lock identifier"
        return 1
    fi

    lock_path="${lock_dir}/claudux-${path_hash}.lock.d"
    legacy_lock_file="${lock_dir}/claudux-${path_hash}.lock"

    if ! recover_legacy_lock "$legacy_lock_file"; then
        return 1
    fi

    while [[ $attempts -lt 20 ]]; do
        if mkdir "$lock_path" 2>/dev/null; then
            if ! (umask 077 && printf '%s\n' "$$" > "$lock_path/pid"); then
                rm -rf -- "$lock_path"
                warn "Could not record project lock ownership"
                return 1
            fi

            CLAUDUX_LOCK_PATH="$lock_path"
            return 0
        fi

        if [[ -L "$lock_path" ]] || [[ ! -d "$lock_path" ]]; then
            warn "Project lock is not a safe directory: $lock_path"
            return 1
        fi

        lock_pid=$(cat "$lock_path/pid" 2>/dev/null || true)
        if ! is_lock_pid "$lock_pid"; then
            warn "Project lock has an invalid owner and cannot be recovered safely: $lock_path"
            return 1
        fi
        if kill -0 "$lock_pid" 2>/dev/null; then
            report_live_lock "$lock_pid"
            return 1
        fi

        reclaim_stale_lock "$lock_path" "$lock_pid"
        reclaim_result=$?
        if [[ $reclaim_result -eq 0 ]]; then
            attempts=$((attempts + 1))
            continue
        fi
        if [[ $reclaim_result -ne 2 ]]; then
            warn "Project lock changed during stale-lock recovery"
            return 1
        fi

        sleep 0.05
        attempts=$((attempts + 1))
    done

    warn "Could not acquire project lock after waiting for stale-lock recovery"
    return 1
}

node_major_version() {
    local version="${1:-}"

    version="${version#v}"
    version="${version%%.*}"
    if [[ ! "$version" =~ ^[0-9]+$ ]]; then
        return 1
    fi

    printf '%s\n' "$version"
}

# Validate required dependencies
validate_dependencies() {
    local has_errors=false
    
    # Check for Node.js
    if ! command -v node >/dev/null 2>&1; then
        echo "ERROR: Node.js is required but not installed" >&2
        echo "  Install from: https://nodejs.org/" >&2
        has_errors=true
    else
        # Check Node version (require v18+)
        local node_output node_version
        node_output=$(node --version 2>/dev/null || true)
        if ! node_version=$(node_major_version "$node_output"); then
            echo "ERROR: Could not determine the installed Node.js version" >&2
            has_errors=true
        elif [[ "$node_version" -lt 18 ]]; then
            echo "ERROR: Node.js v18+ is required (found ${node_output:-unknown})" >&2
            has_errors=true
        fi
    fi
    
    # Check for git
    if ! command -v git >/dev/null 2>&1; then
        echo "WARNING: git is not installed - some features may not work" >&2
    fi
    
    # Check for LLM backend CLI
    if [[ "${CLAUDUX_BACKEND:-}" == "codex" ]]; then
        if ! command -v codex >/dev/null 2>&1; then
            echo "ERROR: Codex CLI is required when CLAUDUX_BACKEND=codex" >&2
            echo "  Install with: npm install -g @openai/codex" >&2
            has_errors=true
        fi
        if [[ "${CODEX_UTILS_MISSING:-}" == "true" ]]; then
            echo "ERROR: lib/codex-utils.sh not found — Codex backend adapter is not installed" >&2
            has_errors=true
        fi
    else
        if ! command -v claude >/dev/null 2>&1; then
            echo "ERROR: Claude CLI is required but not installed" >&2
            echo "  Install with: npm install -g @anthropic-ai/claude-code" >&2
            has_errors=true
        fi
    fi
    
    # Check for mktemp (should be available on all Unix systems)
    if ! command -v mktemp >/dev/null 2>&1; then
        echo "ERROR: mktemp is required but not available" >&2
        has_errors=true
    fi
    
    if $has_errors; then
        echo "" >&2
        echo "Please install missing dependencies and try again" >&2
        exit 1
    fi
}

# Check the active generation backend for commands that invoke the model.
check_generation_backend() {
    local backend="${CLAUDUX_BACKEND:-claude}"

    if [[ "$backend" == "codex" ]]; then
        if declare -F check_codex >/dev/null 2>&1; then
            check_codex
        else
            error_exit "Codex backend requested but check_codex() is unavailable"
        fi
    else
        check_claude
    fi
}

validate_update_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--message|--with)
                if [[ $# -gt 1 && "$2" != -* ]]; then
                    shift 2
                elif [[ $# -gt 1 ]]; then
                    error_exit "Option $1 requires a non-option argument. Usage: claudux update [--with|-m \"message\"] [--strict] [--check]" 2
                else
                    error_exit "Option $1 requires an argument. Usage: claudux update [--with|-m \"message\"] [--strict] [--check]" 2
                fi
                ;;
            --strict|--check)
                shift
                ;;
            --)
                break
                ;;
            -*)
                error_exit "Unknown option for 'update': $1. Usage: claudux update [--with|-m \"message\"] [--strict] [--check]" 2
                ;;
            *)
                error_exit "Unexpected argument: $1" 2
                ;;
        esac
    done
}

# Main function
main() {
    if [[ "${1:-}" == "update" ]]; then
        validate_update_args "${@:2}"
    fi

    case "${1:-}" in
        "update"|""|"check"|"--check")
            validate_backend_selection
            ;;
    esac

    # Only validate dependencies for commands that need the LLM backend.
    # Unknown commands skip validation and fall through to the error handler.
    case "${1:-}" in
        "update"|"")
            validate_dependencies
            # Acquire lock for commands that modify files
            if ! acquire_lock; then
                error_exit "Could not acquire the project lock"
            fi
            ;;
    esac
    
    case "${1:-}" in
        "--version"|"version"|-V)
            # Print version from package.json if available
            local version="unknown"
            if [[ -f "$SCRIPT_DIR/../package.json" ]]; then
                # Try jq first for reliable JSON parsing
                if command -v jq >/dev/null 2>&1; then
                    version=$(jq -r '.version // "unknown"' "$SCRIPT_DIR/../package.json" 2>/dev/null || echo "unknown")
                else
                    # Fallback to grep/sed with better error handling
                    version=$(grep '"version"' "$SCRIPT_DIR/../package.json" 2>/dev/null | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' || echo "unknown")
                fi
            fi
            echo "claudux $version"
            ;;
        "check"|"--check")
            check_function "show_header"
            show_header
            echo "🔎 Environment check"
            echo ""
            # A check that cannot fail is decoration: exit nonzero when a
            # dependency claudux cannot run without is missing, so scripts
            # and CI can trust the exit code.
            local check_failures=0
            # Node version
            if command -v node >/dev/null 2>&1; then
                local node_output node_version
                node_output=$(node --version 2>/dev/null || true)
                echo "• Node: ${node_output:-unknown}"
                if ! node_version=$(node_major_version "$node_output"); then
                    warn "Could not determine the installed Node.js version"
                    check_failures=$((check_failures + 1))
                elif [[ "$node_version" -lt 18 ]]; then
                    warn "Node.js v18+ is required (found ${node_output:-unknown})"
                    check_failures=$((check_failures + 1))
                fi
            else
                warn "Node is not installed"
                check_failures=$((check_failures + 1))
            fi
            # Backend
            local backend="${CLAUDUX_BACKEND:-claude}"
            local backend_cli_present=false
            echo "• Backend: $backend"
            # LLM CLI
            if [[ "$backend" == "codex" ]]; then
                if command -v codex >/dev/null 2>&1; then
                    backend_cli_present=true
                    echo "• Codex CLI: $(codex --version 2>/dev/null || echo 'installed')"
                    echo "• Model: ${CODEX_MODEL:-gpt-5.4}"
                    echo "• Reasoning effort: ${CODEX_REASONING_EFFORT:-xhigh}"
                else
                    warn "Codex CLI not found. Install: npm install -g @openai/codex"
                    check_failures=$((check_failures + 1))
                fi
            else
                if command -v claude >/dev/null 2>&1; then
                    backend_cli_present=true
                    echo "• Claude CLI: $(claude --version 2>/dev/null || echo 'installed')"
                    # Same resolution chain generation uses (get_model_settings):
                    # FORCE_MODEL > claudux.json project.model > sonnet.
                    check_function "load_project_config"
                    load_project_config >/dev/null
                    echo "• Model: ${FORCE_MODEL:-${PROJECT_MODEL:-sonnet}}"
                else
                    warn "Claude CLI not found. Install: npm install -g @anthropic-ai/claude-code"
                    check_failures=$((check_failures + 1))
                fi
            fi
            if $backend_cli_present; then
                check_function "check_generation_backend"
                if ! (check_generation_backend); then
                    warn "Active backend authentication check failed: $backend"
                    check_failures=$((check_failures + 1))
                fi
            fi
            # Docs dir
            if [[ -d "docs" ]]; then
                echo "• docs/: present"
            else
                echo "• docs/: not present (will be created on first run)"
            fi
            echo ""
            if [[ $check_failures -gt 0 ]]; then
                print_color "RED" "❌ Environment check failed ($check_failures problem(s))"
                exit 1
            fi
            echo "✅ Environment check passed"
            ;;
        "update")
            check_function "show_header"
            check_function "check_generation_backend"
            check_function "update"
            show_header
            check_generation_backend
            shift
            update "$@"
            ;;
        "serve"|"server"|"dev")
            check_function "show_header"
            check_function "serve"
            show_header
            serve
            ;;
        "help"|"-h"|"--help")
            show_header
            show_help
            ;;
        "")
            # Default action: show interactive menu
            check_function "show_header"
            check_function "check_generation_backend"
            check_function "show_menu"
            show_header
            check_generation_backend
            show_menu
            ;;
        *)
            # Unknown command
            show_header
            print_color "RED" "❌ Unknown command: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Handle interrupts gracefully
trap 'echo ""; echo "Script interrupted" >&2; kill 0; exit 130' INT TERM QUIT

# Run main function directly (always verbose by default downstream)
main "$@"
